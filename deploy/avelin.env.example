AGENT_NAME=Avelin
AVELIN_SECRET_FILE=/etc/avelin/provider-keys.txt
MODEL_PROVIDER=openai
MODEL_NAME=gpt-6.1-sol
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
OLLAMA_API_KEY=
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=beam:cloud
REASONING_FALLBACK_ENABLED=true
VISION_PRIMARY_MODEL=gemma4:31b
VISION_FALLBACK_MODEL=gpt-6-luna
DATABASE_FILE=/var/lib/avelin/avelin.sqlite3
MEMORY_FILE=/var/lib/avelin/memory.json
TOOL_WORKSPACE_DIR=/var/lib/avelin/workspace
PLAYWRIGHT_BROWSERS_PATH=/opt/avelin/playwright
ALLOW_PRIVATE_HTTP=false
DESKTOP_ALLOW_PYAUTOGUI=false
WEB_PUSH_ENABLED=true
WEB_PUSH_VAPID_PRIVATE_KEY_FILE=/var/lib/avelin/web-push/private.pem
# Production Web Push contact/origin. Subscriptions are origin-bound, so users
# must enable notifications again after moving from Tailscale to this domain.
WEB_PUSH_VAPID_SUBJECT=https://app.avelin.tech
