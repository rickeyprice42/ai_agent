AGENT_NAME=Avelin
MODEL_PROVIDER=ollama_cloud
MODEL_NAME=beam:cloud
OLLAMA_URL=http://localhost:11434
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=beam:cloud
OLLAMA_API_KEY=your_ollama_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
REASONING_FALLBACK_ENABLED=true
VISION_PRIMARY_MODEL=gemma4:31b
VISION_FALLBACK_MODEL=gpt-6-luna
MAX_IMAGE_BYTES=10485760
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_OUTPUT_RESERVE_TOKENS=4096
CONTEXT_COMPACTION_THRESHOLD=0.75
CONTEXT_COMPACTION_KEEP_RECENT=12
DATABASE_FILE=data/avelin.sqlite3
MEMORY_FILE=data/memory.json
TOOL_WORKSPACE_DIR=data/workspace
MAX_FILE_READ_CHARS=20000
MAX_FILE_WRITE_CHARS=20000
SHELL_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=15
MAX_HTTP_RESPONSE_CHARS=20000
ALLOW_PRIVATE_HTTP=false
BROWSER_TIMEOUT_SECONDS=20
# Optional comma-separated public hosts. Empty means one isolated host scope per run.
BROWSER_ALLOWED_HOSTS=
DESKTOP_TIMEOUT_SECONDS=15
DESKTOP_ALLOWED_WINDOW_TITLES=Avelin Test GUI
DESKTOP_ALLOW_PYAUTOGUI=false
SYSTEM_PROMPT=Ты личный AI-агент пользователя. Отвечай дружелюбно, кратко и по делу. Если нужен инструмент, используй его.
